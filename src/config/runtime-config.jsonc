{
  "$schema": "./runtime-config.schema.json",
  // Repo-owned template for the OpenCode config-dir runtime settings file.
  // The live default path is ~/.config/opencode/opencode-context-compression.jsonc.
  // `schedulerMarkThreshold` is an internal/test compatibility threshold by mark count.
  // `markedTokenAutoCompactionThreshold` is the real readiness threshold by marked token total.
  // Reminder repeat cadence is token-based only; legacy counter-driven reminder fields are not part of this contract.
  "version": 1,
  "allowDelete": false,
  "promptPath": "prompts/compaction.md",
  "deletePromptPath": "prompts/delete.md",
  "leadingUserPromptPath": "prompts/projection-leading-user.md",
  "compactionModels": [
    "google.cctq/gemini-3-flash-preview",
    "google.right/gemini-3-flash-preview",
    "google.doro/gemini-3-flash-preview",
  ],
  "schedulerMarkThreshold": 1,
  "runtimeLogPath": "logs/runtime-events.jsonl",
  "seamLogPath": "logs/seam-observation.jsonl",
  // debugSnapshotPath 在每次 messages.transform 写全量消息快照，超大会话单轮可达 GB 级；默认关闭。
  // runtimeLogPath / seamLogPath / debugSnapshotPath 三者设为 null 均可关闭对应写入。
  // "debugSnapshotPath": "logs/debug-snapshots",
  "markedTokenAutoCompactionThreshold": 50000,
  "smallUserMessageThreshold": 1536,
  "reminder": {
    // Reminder prompt assets are plain-text files selected by severity × allowDelete.
    "hsoft": 40000,
    "hhard": 150000,
    "hdelete": 60000,
    // del + comp > cpmarkThreshold + fixed 时发送用户提醒；回落 30000 后重新激活。
    "cpmarkThreshold": 190000,
    "softRepeatEveryTokens": 30000,
    "hardRepeatEveryTokens": 10000,
    "promptPaths": {
      "retire": "prompts/reminder-retire.md",
      "compactOnly": {
        "soft": "prompts/reminder-soft-compact-only.md",
        "hard": "prompts/reminder-hard-compact-only.md"
      },
      "deleteAllowed": {
        "soft": "prompts/reminder-soft-delete-allowed.md",
        "hard": "prompts/reminder-hard-delete-allowed.md"
      }
    }
  },
  "logging": {
    "level": "debug"
  },
  "compressing": {
    "timeoutSeconds": 600,
    "firstTokenTimeoutSeconds": 40,
    "streamIdleTimeoutSeconds": 40,
    "maxFailureCount": 99999
  },
  "toast": {
    "enabled": true,
    "durations": {
      // Set an individual toast duration to 0 to disable only that toast type.
      "startup": 3000,
      "softReminder": 5000,
      "hardReminder": 7000,
      "compressionStart": 3000,
      "compressionComplete": 4000,
      "compressionFailed": 5000
    }
  }
}
